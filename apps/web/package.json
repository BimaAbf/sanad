{
  "name": "@misk/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-fonts": "node scripts/sync-fonts.mjs",
    "predev": "node scripts/sync-fonts.mjs",
    "prebuild": "node scripts/sync-fonts.mjs",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep axe-core",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "next": "15.1.3",
    "next-intl": "3.26.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@lhci/cli": "0.14.0",
    "@misk/config": "workspace:*",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
