# ─────────────────────────────────────────────────────────────────────────────
# سند (Sanad) — local development environment
# Copy to .env (`just bootstrap` does this). .env is gitignored. NEVER commit it.
# Every variable below is REQUIRED unless marked OPTIONAL: the API refuses to
# start if a required one is missing, and names the variable in the error.
# ─────────────────────────────────────────────────────────────────────────────

# --- runtime ---------------------------------------------------------------
SANAD_ENVIRONMENT=local              # local | ci | staging | production
SANAD_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
SANAD_SERVICE_NAME=sanad-api

# --- datastores ------------------------------------------------------------
SANAD_DATABASE_URL=postgresql+asyncpg://sanad:sanad@localhost:55432/sanad
SANAD_REDIS_URL=redis://localhost:56379/0

# --- object storage (MinIO locally; Cloudflare R2 in staging/production) ----
SANAD_S3_ENDPOINT_URL=http://localhost:59000
SANAD_S3_REGION=us-east-1
SANAD_S3_BUCKET=sanad-media
SANAD_S3_ACCESS_KEY_ID=sanadminio
SANAD_S3_SECRET_ACCESS_KEY=sanadminio-dev-secret

# --- web -------------------------------------------------------------------
SANAD_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- observability (OPTIONAL: unset disables the exporter, never the app) ---
# SANAD_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ─────────────────────────────────────────────────────────────────────────────
# Credentials below are NOT needed to build or test. Every one of them has a
# deterministic / fixture fallback. See SETUP.md §2 for which gate needs which.
# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=        # Gate 4 — DP1 interpret, DP4 report
# GROQ_API_KEY=             # Gate 4 — DP0, DP2, DP3, summaries, and ASR failover
# SANAD_SMS_PROVIDER=null    # null | twilio | local_aggregator   (Stage 1 real-device only)

# Which provider the gateway speaks to. "groq" is the DEFAULT and does not need
# to be set — docs/12 §2 routes every decision point to Groq
# `openai/gpt-oss-120b`. Set it to "anthropic" only to route DP1/DP4 to Claude,
# which docs/12 leaves open pending the interpret_ar eval.
# AI_PROVIDER=groq          # groq | anthropic

# The live-AI switch. A key ALONE changes nothing: with AI_LIVE unset or 0 the
# gateway replays recorded fixtures and makes no network call at all. Spending
# money, or sending anything anywhere, needs BOTH this and a key — which is the
# point.
#
# AI_LIVE=1 without the key for the CONFIGURED PROVIDER is a startup error, not
# a silent fall back to fixtures. Which key that is follows AI_PROVIDER: with
# the default it is GROQ_API_KEY, and an ANTHROPIC_API_KEY alone will not
# satisfy it. The error names the variable it wanted.
# AI_LIVE=1

# The self-hosted Qwen3-ASR host, when there is one (docs/12 §3.2 calls this the
# primary and Groq Whisper the failover). Absent means the ASR chain is
# Groq-only; absent AND no GROQ_API_KEY means the chain is empty, which is a
# supported mode — the child app says the microphone is unavailable and the
# caregiver-confirm button carries the attempt.
# SANAD_ASR_QWEN_BASE_URL=http://localhost:8001/v1

# Overridable so a test can point the ASR transport at a local stub.
# SANAD_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Cloudflare R2 (Gate 5). R2 is S3-compatible, so setting these plus pointing
# SANAD_S3_ENDPOINT_URL at https://<account-id>.r2.cloudflarestorage.com is the
# whole migration from local MinIO -- no code changes. docs/setup/03.
# SANAD_R2_ACCOUNT_ID=
# SANAD_R2_ACCESS_KEY_ID=
# SANAD_R2_SECRET_ACCESS_KEY=

# GPU provider for the VoxCPM2 render (Gate 5). Do not buy this before there is
# a recording to render -- REVIEW-QUEUE #10 is the blocker, not this token.
# SANAD_GPU_PROVIDER_TOKEN=

# Contingency only: needed if VoxCPM2 loses the listening test (REVIEW-QUEUE #11).
# AZURE_SPEECH_KEY=
