# ─────────────────────────────────────────────────────────────────────────────
# مِسك (Misk) — local development environment
# Copy to .env (`just bootstrap` does this). .env is gitignored. NEVER commit it.
# Every variable below is REQUIRED unless marked OPTIONAL: the API refuses to
# start if a required one is missing, and names the variable in the error.
# ─────────────────────────────────────────────────────────────────────────────

# --- runtime ---------------------------------------------------------------
MISK_ENVIRONMENT=local              # local | ci | staging | production
MISK_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
MISK_SERVICE_NAME=misk-api

# --- datastores ------------------------------------------------------------
MISK_DATABASE_URL=postgresql+asyncpg://misk:misk@localhost:55432/misk
MISK_REDIS_URL=redis://localhost:56379/0

# --- object storage (MinIO locally; Cloudflare R2 in staging/production) ----
MISK_S3_ENDPOINT_URL=http://localhost:59000
MISK_S3_REGION=us-east-1
MISK_S3_BUCKET=misk-media
MISK_S3_ACCESS_KEY_ID=miskminio
MISK_S3_SECRET_ACCESS_KEY=miskminio-dev-secret

# --- web -------------------------------------------------------------------
MISK_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- observability (OPTIONAL: unset disables the exporter, never the app) ---
# MISK_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ─────────────────────────────────────────────────────────────────────────────
# Credentials below are NOT needed to build or test. Every one of them has a
# deterministic / fixture fallback. See SETUP.md §2 for which gate needs which.
# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=        # Gate 4 — DP1 interpret, DP4 report
# GROQ_API_KEY=             # Gate 4 — DP0, DP2, DP3, summaries
# MISK_SMS_PROVIDER=null    # null | twilio | local_aggregator   (Stage 1 real-device only)
